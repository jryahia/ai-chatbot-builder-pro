# ============================================================
# AI Chatbot Builder Pro — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Database ---
# Use SQLite for standalone mode (default), PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/chatbot_builder.db
# DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_secret@localhost:5432/chatbot_builder

# PostgreSQL credentials (only needed if using Docker Compose)
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_DB=chatbot_builder

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars

# Encryption key for API keys stored in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama (for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# Default LLM provider: openai | anthropic | google | ollama
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# --- Embeddings ---
# Provider: sentence_transformers | openai | anthropic
DEFAULT_EMBEDDING_PROVIDER=sentence_transformers
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=chatbot_

# Optional: Pinecone cloud sync
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=chatbot-builder

# --- Server ---
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=info

# CORS allowed origins (comma-separated or * for all)
CORS_ORIGINS=*

# --- File Storage ---
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=100

# --- Rate Limiting ---
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_RATE_LIMIT_PER_DAY=10000

# --- Chunking Defaults ---
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_CHUNKING_STRATEGY=recursive

# --- UI ---
FLET_PORT=8550
